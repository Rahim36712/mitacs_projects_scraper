[Unit]
Description=Mitacs Scraper API (Flask + Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_DIR__/.venv/bin/gunicorn --bind 0.0.0.0:__PORT__ --workers 1 --threads 8 --timeout 300 mitacs_scraper.ui_app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
